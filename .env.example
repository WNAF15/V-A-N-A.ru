# N-A-V-A object storage. Keep S3_ENABLED=0 until your external bucket is ready.
S3_ENABLED=0
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=1
S3_URL_TTL=600

# Temporary no-payment storage fallback
STORAGE_DRIVER=local
LOCAL_STORAGE_ENABLED=1
NAVA_STORAGE_LOCAL_SECRET=replace-with-a-long-random-secret

# Later, when R2/S3 is available:
# STORAGE_DRIVER=r2
# S3_ENABLED=1
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=nava-media
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
