# Copy to .env outside the public web root and fill with private hosting values.
APP_DEBUG=0
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# Local media storage
STORAGE_DRIVER=local
LOCAL_STORAGE_ENABLED=1
NAVA_STORAGE_LOCAL_SECRET=replace-with-a-random-secret-of-at-least-64-characters

# Optional S3-compatible storage (disabled until configured)
S3_ENABLED=0
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=1
S3_URL_TTL=600
